#!/usr/bin/env bash
# Build the real-Wii DOL (Release, no CREATE_LOG) into sd/apps/reVC/boot.dol.
# Copy that folder onto a FAT32 SD card; do not use this build for Dolphin iteration.
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/wii-common.sh"

wii_require_data
wii_configure_and_build "$RELEASE_BUILD_DIR" Release OFF

printf 'release DOL ready at %s\n' "$BOOT_DOL"
printf 'HBC: copy hbc/apps/reVC/ onto the SD card as apps/reVC/\n'
printf 'data: copy sd/apps/reVC/ (the 1.5G game tree) to USB as apps/reVC/\n'
printf 'launch from Homebrew Channel (press 1 for USB). USB Loader GX will not boot this.\n'
